    Image reductions to apply when aligning (-1 for default) and when summing
 -target (-tar)  OR  -TargetAlignSize   Int
    Target size to reduce images to for aligning
 -frames (-fra)  OR  -StartingEndingFrames   2 ints
    First and last frame in each file to align and sum, numbered from 1
 -partial (-par)  OR  -PartialFrameThresholds   2 floats
    Relative thresholds for skipping frames at start and end of a frame set
 -drift (-dr)  OR  -DriftLimitDistAndNumber   2 floats
    Shift above which to drop initial frames, and max # or fraction to drop
 -sets (-se)  OR  -RangeOfSetsToDo   2 ints
    First and last frame set or file to process, numbered from 1 (default all)
 -mode (-mo)  OR  -ModeToOutput   Int
    Mode for output image file
 -scale (-sc)  OR  -ScalingOfSum   Float
    Amount to scale summed values before output
 -total (-to)  OR  -TotalScalingOfData   Float
    Scale by given amount divided by existing scaling from header
 -meansd (-mea)  OR  -MeanAndSDtoScaleTo   2 floats
    Scale to given mean and standard deviation, or to just to mean if SD 0
 -rfsum (-rf)  OR  -SumRotationAndFlip   Int
    Rotation and flip operation to apply to sum before output
 -tilt (-til)  OR  -TiltAngleFile   File
    File with tilt angles to insert into header of output file
 -axis (-ax)  OR  -AxisRotationAngle   Float
    Rotation angle of tilt axis to place in a title in the output file
 -xfext (-x)  OR  -TransformExtension   String
    Extension for output file(s) with image transformations (shifts)
 -frc  OR  -FRCOutputFile   File
    Output file for Fourier ring correlations
 -ring (-ri)  OR  -RingSpacingForFRC   Float
    Frequency spacing of rings in FRC (default 0.005).
 -lines (-lin)  OR  -LinesOfAlignSummary   Int
    Number of lines summarizing fitting/FRC results (1 to 3, default 2)
 -plottable (-pl)  OR  -PlottableShiftFile   File
    Filename for output file with raw and smoothed shifts
 -nosum (-nos)  OR  -NoSumsOutput
    Do alignments without making sum; omit output file

PREPROCESSING OPTIONS
 -titles (-tit)  OR  -RefAndDefectFromTitles
    Take gain reference and defect file names from titles in header
 -gain (-gai)  OR  -GainReferenceFile   File
    Gain reference for gain-normalizing frames
 -rotation (-ro)  OR  -RotationAndFlip   Int
    Rotation and flip operation that needs to be applied to gain reference
 -dark (-da)  OR  -DarkReferenceFile   File
    Dark reference to be subtracted before gain-normalizing frames
 -defect (-def)  OR  -CameraDefectFile   File
    File of camera defects to correct
 -double (-do)  OR  -DoubleDefectCoords
    Scale camera defect coordinates by 2 if not already scaled
 -imagebinned (-im)  OR  -ImagesAreBinned   Float
    Binning of images, possibly needed for defect correction
 -truncate (-tru)  OR  -TruncateAbove   Float
    Replace values above a limit with surrounding mean

ALIGNMENT OPTIONS
 -pair (-pai)  OR  -PairwiseFrames   Int
    # of frames for pairwise alignments (-1 for all), or 0 for cumulative
    alignment (default 7)
 -reverse (-rev)  OR  -ReverseOrder
    Reverse order of processing
 -shift (-shi)  OR  -ShiftLimit   Int
    Limit on distance to search for correlation peak (default 20)
 -group (-gr)  OR  -GroupSize   Int
    # of frames to sum for correlations
 -radius2  OR  -FilterRadius2   Float
    Right cutoff radius for filter, in unbinned frequency units
 -vary (-va)  OR  -VaryFilter   Floats
    Set of radius2 filter values to test
    (Successive entries accumulate)
 -hybrid (-hy)  OR  -UseHybridShifts
    Use shifts based on shifts from best filter for each fit
 -refine (-ref)  OR  -RefineAlignment   Int
    # of times to refine alignment by aligning each image to aligned sum
 -rgroup (-rg)  OR  -RefineWithGroupSums
    Refine with group sums if using groups for initial alignment
 -stop (-sto)  OR  -StopIterationsAtShift   Float
    Maximum change in shift at which to stop refining (default 0.1).
 -rrad2 (-rr)  OR  -RefineRadius2   Float
    High frequency filter cutoff (radius 2) for refining the alignment.
 -smooth (-sm)  OR  -MinForSplineSmoothing   Int
    Minimum # of frames for smoothing shifts with spline curve (default 20)
 -gpu (-gp)  OR  -UseGPU   Int
    Use GPU for computation; 0 for best available one or number of GPU
 -memory (-mem)  OR  -MemoryLimitGB   Floats
    Limit on CPU memory usage, and optionally on GPU memory usage

DOSE WEIGHT FILTERING OPTIONS
 -dtype (-dty)  OR  -TypeOfDoseFile   Int
    Format of file with dose information (1: doses only, 2: prior dose and
    dose, 3: prior and ending dose, 4: mdoc, 5: frame doses)
 -dfile (-dfi)  OR  -DoseWeightingFile   File
    Name of file with dose information for dose weighting
 -dtotal (-dto)  OR  -FixedTotalDose   Float
    Total dose for each set of frames, in electrons/square Angstrom
 -dframe (-dfr)  OR  -FixedFrameDoses   Float
    List of frame doses and numbers that applies to all frame sets
 -dprior (-dp)  OR  -InitialPriorDose   Float
    Dose applied before any of the images in each frame set were taken
 -bidir (-bid)  OR  -BidirectionalNumViews   Int
    Number of views in first part of bidirectional tilt series
 -accum (-ac)  OR  -DoseAccumulates   Int
    1 or 2 to accumulate dose from one frame set to the next, 0 not to
 -normalize (-nor)  OR  -NormalizeDoseWeighting
    Normalize the dose weight filters to sum to 1 within each frame set
 -volt (-vo)  OR  -Voltage   Int
    Microscope voltage in kV; must be either 200 or 300 (default 300)
 -optimal (-op)  OR  -OptimalDoseScaling   Float
    Factor by which to scale the computed optimal and critical doses
 -critical (-c)  OR  -CriticalDoseFactors   3 floats
    Replacement factors a, b, and c in the equation for critical dose
 -unweight (-un)  OR  -UnweightedOutputFile   File
    File name for summed images that have not been dose weighted

OPTIONS FOR ASSESSING ALIGNMENT AND OTHER TEST PURPOSES
 -test (-te)  OR  -TestBinnings   Ints
    Set of binnings at which to test pairwise alignments
 -assess (-as)  OR  -AssessWithFrames   2 ints
    Starting and ending frame to use during testing of parameters
 -good (-go)  OR  -GoodEnoughError   Float
    Combined error measure that is sufficient to stop testing binnings
 -weight (-w)  OR  -MaxResidualWeight   Float
    Weight for maximum residual when computing single error measure
 -trim (-tri)  OR  -TrimFraction   Float
    Fraction of image size to trim off each edge for correlations
 -taper (-tap)  OR  -TaperFraction   Float
    Fraction of image size to taper on each edge for correlations
 -antialias (-an)  OR  -AntialiasFilter   Int
    Type of filter for image reduction when trimming or tapering
 -radius1  OR  -FilterRadius1   Float
    Left cutoff radius for filter
 -sigma1  OR  -FilterSigma1   Float
    Sigma for low-frequency inverted Gaussian filter (default 0.03)
 -sigma2  OR  -FilterSigma2   Float
    Sigma for Gaussian rolloff below radius1 and above radius2
 -kfactor (-k)  OR  -KFactorForFits   Float
    K factor for robust fitting to pairwise alignments
 -debug (-deb)  OR  -DebugOutput   Int
    Sum of 1 or 2 for debug output, 10 for timing, 100 for correlations, 1000
    for refining correlations, 10000 for even/odd sums
 -flags (-fl)  OR  -FlagsForGPU   Int
    Flags to control which initial kinds of processing occur on the GPU
 -shrmem (-shr)  OR  -ShrMemTest
    Use shrmemframe to do align frames (special Windows build only)
 -help (-he)  OR  -usage
    Print help output
exit=0

